# Public site URL - used for canonical URLs, sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://calchub.example.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave unset to disable analytics entirely (no script is loaded).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Leave unset to render placeholder ad slots instead of live ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
